# Build with --platform linux/amd64. Azure dependencies stay out of the static image.
FROM python:3.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /usr/local/bin/uv
ENV PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1 UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --frozen --no-dev --extra foundry
ENV PATH="/app/.venv/bin:$PATH"
USER 1000:1000
EXPOSE 8088
ENTRYPOINT ["/app/.venv/bin/aipod"]
CMD ["agent", "--foundry"]
